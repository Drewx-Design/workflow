{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
